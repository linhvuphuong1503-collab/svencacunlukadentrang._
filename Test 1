<style>#necPracticeTools{position:fixed;right:14px;bottom:14px;z-index:9998;background:#fff;border:1px solid #cbd5e1;border-radius:14px;padding:10px 12px;box-shadow:0 8px 30px #0002;font-family:Arial,sans-serif;min-width:190px}#necPracticeTools b{color:#102a43}#necTimer.up{color:#b91c1c}#necPracticeTools button{margin-top:7px;border:0;border-radius:8px;padding:7px 9px;cursor:pointer;background:#173b67;color:white}@media(max-width:600px){#necPracticeTools{right:8px;bottom:8px;min-width:160px;font-size:13px}}</style><div id="necPracticeTools"><b>Practice tools</b><div id="necTimer">No timer</div><button type="button" onclick="necNewAttempt()">Start New Attempt</button></div><script>(function(){const p=new URLSearchParams(location.search),mins=parseInt(p.get('timer')||'0',10)||0;let end=mins?Date.now()+mins*60000:0,tick=null,te=document.getElementById('necTimer');function f(){if(!mins){te.textContent='No timer';return}let s=Math.max(0,Math.ceil((end-Date.now())/1000));te.textContent='Time left: '+Math.floor(s/60)+':'+String(s%60).padStart(2,'0');if(s<=0){te.textContent='Time is up';te.classList.add('up');clearInterval(tick);alert('Your practice time is up. You may finish the current question and submit when ready.')}}f();if(mins)tick=setInterval(f,1000);window.necNewAttempt=function(){if(!confirm('Start a new attempt? Your current answers on this device will be cleared.'))return;try{localStorage.removeItem(KEY)}catch(e){}location.reload()}})();</script></body></html>
